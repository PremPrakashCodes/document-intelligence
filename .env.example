# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# prebuilt-layout is the table/structure model; prebuilt-read is OCR only.
AZURE_DI_MODEL=prebuilt-layout
AZURE_DI_TIMEOUT=300
AZURE_DI_MAX_ATTEMPTS=4
AZURE_DI_BACKOFF_SECONDS=2.0

# Extraction thresholds (see docs/extraction.md)
# Word -> cell membership. Above 0.5 this is an exclusive assignment: a word
# can exceed 50% containment in at most one cell of a non-overlapping grid.
CELL_WORD_CONTAINMENT_THRESHOLD=0.55
# Strong-match bar for preferring the PDF's own text over Azure's reading.
CELL_MATCH_CONTAINMENT_THRESHOLD=0.55
# A page with less extractable text than this is treated as scanned.
TEXT_LAYER_MIN_CHARS=24
MAX_UPLOAD_BYTES=67108864

# Infrastructure (see compose.yml for local defaults)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Background jobs (BullMQ on Postgres)
QUEUE_SCHEMA=bullmq
QUEUE_CONCURRENCY=4

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=drive
# Overrides the account-derived endpoint; useful for MinIO or tests.
R2_ENDPOINT_URL=

# API
DEBUG=false
CORS_ORIGINS=http://localhost:5173
